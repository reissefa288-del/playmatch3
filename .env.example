# Firebase Authentication (required for Google sign-in)
# 1) Firebase Console → Project settings → Web app → config → firebase/firebase-web-config.json
# 2) npm run firebase:init-env  → creates .env + .env.production
# 3) Authentication → Google → Enable; Authorized domains: localhost
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Web Push (ADIM 9.1) — Firebase Console → Cloud Messaging → Web Push certificates
# VITE_FIREBASE_VAPID_KEY=

# Dev only — localhost / Cursor preview: auto login + home (set false to test welcome)
# VITE_DEV_AUTO_HOME=false

# App Check (ADIM 3.3)
# VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Production monitoring (ADIM 12.3) — optional; open beta öncesi önerilir
# VITE_SENTRY_DSN=
# VITE_RUM_SAMPLE_RATE=0.05
# VITE_APP_RELEASE=playmeet@1.0.0
# VITE_RUM_ENDPOINT=

# Photo CDN (P12) — optional; local bundled assets when unset
# VITE_CDN_BASE_URL=https://cdn.playmeet.example

# Premium (ADIM 8.1–8.2) — varsayılan açık; kapalı testte gizlemek için:
# VITE_PREMIUM_ENABLED=false
# TWA olmadan Play Billing simülasyonu (geliştirme / kapalı test):
# VITE_PREMIUM_STUB_PURCHASES=true

# Production build — copy to .env.production (see .env.production.example)
# npm run env:check:production
# npm run deploy:firebase
