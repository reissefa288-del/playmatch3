# Copy to .env.production before production build / Firebase Hosting deploy.
# Vite loads .env.production automatically when NODE_ENV=production.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (ADIM 9.1) — Firebase Console → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# App Check (ADIM 3.3) — reCAPTCHA v3 site key
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Premium (ADIM 8.1–8.2) — varsayılan açık; Play Billing kapalı testte UI gizlemek için:
# VITE_PREMIUM_ENABLED=false
# TWA olmadan Play Billing simülasyonu:
# VITE_PREMIUM_STUB_PURCHASES=true

# Optional monitoring (ADIM 12.3 — open beta öncesi önerilir)
# VITE_SENTRY_DSN=
# VITE_RUM_SAMPLE_RATE=0.05
# VITE_APP_RELEASE=playmeet@1.0.0
# VITE_RUM_ENDPOINT=
