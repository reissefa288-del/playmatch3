      "app-shell.js": 26,
      "shared-ui.js": 5,
      "shared-hooks.js": 3,
      "vendor-react.js": 65,
    "vendor-sentry.js": 130,
      "index.css": 10,
      "HomeScreenBody.js": 8,
      "home-shell.js": 9,
      "profile-shell.js": 9,
      "games-shell.js": 9,
