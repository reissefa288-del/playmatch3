  "media": {
    "maxVideoFileMb": 2,
    "maxDistImageAssetsMb": 5.5,
    "maxDistCodeAssetsMb": 2.5,
    "maxDistAssetsMbExcludingVideo": 8
  },
  "runtime": {
    "maxMountedTabs": 2,
    "pinnedTabIds": ["chat"]
  },
  "production": {
    "minBrotliSavingsPercent": 12,
    "rumSampleRate": 0.05,
    "sourceMapsInDist": false
  },
  "rum": {
    "targets": {
      "lcpP75Ms": 2500,
      "inpP75Ms": 200,
      "clsP75": 0.1
    }
  },
  "pwa": {
    "maxPrecacheKb": 960
  },
  "photo": {
    "maxBlurKb": 2
  },
  "games": {
    "maxCanvasDpr": 2,
    "duelRenderBatchFrames": 2
  },
  "lighthouse": {
    "environment": "production-static-preview",
    "targets": {
