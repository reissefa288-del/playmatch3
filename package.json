{
  "name": "playmeet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "normalize:a5": "node scripts/normalize-a5-gem.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:video": "node scripts/optimize-video.mjs",
    "optimize:media": "node scripts/optimize-images.mjs && node scripts/optimize-video.mjs",
    "perf:images": "node scripts/check-image-sources.mjs",
    "perf:media": "node scripts/check-media-budgets.mjs",
    "perf:runtime": "node scripts/check-runtime-timers.mjs",
    "perf:paint": "node scripts/check-css-paint.mjs",
    "perf:games": "node scripts/check-game-canvas.mjs",
    "perf:production": "node scripts/perf-audit.mjs",
    "build:production": "npm run build && node scripts/compress-dist-brotli.mjs && npm run validate:dist",
    "validate:dist": "node scripts/validate-dist-production.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "env:check:production": "node scripts/check-production-env.mjs",
    "validate:firebase": "node scripts/validate-firebase-production.mjs",
    "validate:firestore-rules": "node scripts/validate-firestore-rules.mjs",
    "validate:storage-rules": "node scripts/validate-storage-rules.mjs",
    "validate:app-check": "node scripts/validate-app-check.mjs",
    "app-check:preflight": "node scripts/app-check-enforce-preflight.mjs",
    "deploy:app-check-rollout": "npm run app-check:preflight && npm run deploy:hosting",
    "validate:twa": "node scripts/validate-twa-production.mjs",
    "twa:sync-host": "node scripts/sync-twa-host.mjs",
    "twa:fingerprint": "node scripts/extract-twa-fingerprint.mjs",
    "twa:apply-fingerprint": "node scripts/apply-twa-fingerprint.mjs",
    "twa:keystore": "node scripts/generate-twa-keystore.mjs",
    "twa:setup-signing": "node scripts/setup-twa-signing.mjs",
    "twa:preflight-build": "node scripts/twa-preflight-build.mjs",
    "twa:init": "node scripts/twa-init.mjs",
    "twa:build": "node scripts/twa-build.mjs",
    "play:preflight-console": "node scripts/validate-play-console-ready.mjs",
    "closed-test:preflight": "node scripts/validate-closed-test-ready.mjs",
    "firebase:verify-setup": "node scripts/verify-firebase-console-ready.mjs",
    "firebase:init-env": "node scripts/init-env-production.mjs",
    "deploy:preflight": "node scripts/deploy-firebase-preflight.mjs",
    "security:preflight": "node scripts/deploy-security-preflight.mjs",
    "deploy:security": "npm run security:preflight && npx firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:rules": "npm run deploy:security",
    "deploy:hosting": "npm run deploy:preflight && npm run build:production && npx firebase deploy --only hosting",
    "deploy:firebase": "npm run deploy:preflight && npm run build:production && npx firebase deploy --only hosting,firestore:rules,firestore:indexes,storage",
    "deploy:p0-backend": "node scripts/deploy-p0-backend.mjs",
    "deploy:p0-android": "node scripts/deploy-p0-android.mjs",
    "p0:status": "node scripts/p0-backend-status.mjs",
    "p0:android:status": "node scripts/p0-android-status.mjs",
    "validate:functions": "node scripts/validate-functions.mjs",
    "functions:build": "npm --prefix functions run build",
    "functions:preflight": "node scripts/functions-preflight.mjs",
    "deploy:functions": "npm run functions:preflight && npx firebase deploy --only functions",
    "post-deploy:smoke": "node scripts/post-deploy-smoke.mjs",
    "release:regression": "node scripts/release-regression.mjs",
    "validate:rum": "node scripts/check-production-rum.mjs",
    "analyze:bundle": "tsc -b && vite build --mode analyze",
    "perf:budgets": "node scripts/check-bundle-budgets.mjs",
    "perf:lighthouse": "node scripts/lighthouse-baseline.mjs",
    "perf:lighthouse:check": "node scripts/check-lighthouse-budgets.mjs",
    "perf:lighthouse:targets": "node scripts/check-lighthouse-budgets.mjs --targets",
    "perf:audit": "node scripts/perf-audit.mjs",
    "perf:audit:full": "node scripts/perf-audit.mjs --full",
    "lighthouse:baseline": "npm run perf:lighthouse",
    "server:dev": "node --watch server/index.js",
    "server:start": "node server/index.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@sentry/react": "^9.47.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chrome-launcher": "^1.2.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-tools": "^14.27.0",
    "globals": "^17.6.0",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^24.36.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
